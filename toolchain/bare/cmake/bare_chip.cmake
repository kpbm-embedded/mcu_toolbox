# Include BEFORE project(): picks the toolchain file for CHIP. Usage (see templates/bare/*):
#   set(CHIP "mps2-an385" CACHE STRING "chip: see $MCU_BARE/chips")
#   include($ENV{MCU_BARE}/cmake/bare_chip.cmake)
#   project(app C ASM)
#   include($ENV{MCU_BARE}/cmake/bare.cmake)
#   add_executable(app src/main.c)
#   bare_firmware(app)
get_filename_component(MCU_BARE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT CHIP)
  message(FATAL_ERROR "set CHIP (one of the dirs in ${MCU_BARE_DIR}/chips)")
endif()
if(NOT EXISTS ${MCU_BARE_DIR}/chips/${CHIP}/chip.cmake)
  file(GLOB _chips RELATIVE ${MCU_BARE_DIR}/chips ${MCU_BARE_DIR}/chips/*/chip.cmake)
  message(FATAL_ERROR "unknown CHIP '${CHIP}' (have: ${_chips})")
endif()
include(${MCU_BARE_DIR}/chips/${CHIP}/chip.cmake)   # CHIP_ARCH CHIP_FLAGS CHIP_LD CHIP_SOURCES CHIP_DEFINES CHIP_RUN
if(NOT CMAKE_TOOLCHAIN_FILE)
  if(CHIP_ARCH STREQUAL "riscv")
    set(CMAKE_TOOLCHAIN_FILE ${MCU_BARE_DIR}/cmake/riscv-none-elf.cmake)
  else()
    set(CMAKE_TOOLCHAIN_FILE ${MCU_BARE_DIR}/cmake/arm-none-eabi.cmake)
  endif()
endif()
