# Shared CMake toolchain file: xPack RISC-V GCC (riscv-none-elf, from wch/toolchain), bare metal, RV32/RV64.
#   cmake -DCMAKE_TOOLCHAIN_FILE=$MCU_BARE/cmake/riscv-none-elf.cmake ...   (source bare/env.sh first)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv)
set(CMAKE_C_COMPILER riscv-none-elf-gcc)
set(CMAKE_CXX_COMPILER riscv-none-elf-g++)
set(CMAKE_ASM_COMPILER riscv-none-elf-gcc)
set(CMAKE_OBJCOPY riscv-none-elf-objcopy)
set(CMAKE_OBJDUMP riscv-none-elf-objdump)
set(CMAKE_SIZE riscv-none-elf-size)
set(CMAKE_NM riscv-none-elf-nm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
