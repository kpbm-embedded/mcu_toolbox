// CH32V003 for Renode (Renode 1.17 has no WCH model): RV32EC core, 16 KiB flash, SRAM, and the STM32F1-style
// USART1/GPIO blocks the chip uses (Renode's STM32 models fit). Not modelled: PFIC interrupts, SysTick, clocks.
cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32ec_zicsr"
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10
    timeProvider: empty

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x4000

// MappedMemory needs 4 KiB pages; the linker script keeps to the real 2 KiB
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x1000

usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>

gpioPortD: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011400, +0x400>

rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: false
    script: "request.Value = 0x03000000 if request.IsRead else 0"
