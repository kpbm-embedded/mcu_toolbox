# cross compiler for CLion's code insight (firmware-index); generated by mcu-ide
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
get_filename_component(_MCU_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../tool" ABSOLUTE)
set(CMAKE_C_COMPILER "${_MCU_ROOT}/tools/toolchains/arm-gnu-toolchain/bin/arm-none-eabi-gcc")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
